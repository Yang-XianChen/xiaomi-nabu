 #define ASM_SHIFT_GAPLESS_MODE_FLAG	31
 #define ADSP_MEMORY_MAP_SHMEM8_4K_POOL	3
 
+/*
+ * nabu: attenuate the ASM PCM playback stream inside the DSP before the
+ * matrix/AFE path. System volume 100% (0dBFS) clips somewhere in the
+ * DSP->AFE->CS35L41 input path; a small pre-matrix attenuation keeps the
+ * full-scale digital signal below the clipping threshold. Q13 linear gain,
+ * 8192 = 0 dB (unity), 5800 ~= -3 dB, 4106 ~= -6 dB.
+ * Deployed default: 4106 (-6 dB) after Easy Effects limiter confirmed the
+ * level-dependent clipping in the DSP path.
+ */
+static int nabu_stream_gain_q13 = 4106;
+module_param(nabu_stream_gain_q13, int, 0644);
+MODULE_PARM_DESC(nabu_stream_gain_q13,
+		 "Q13 master gain for ASM PCM playback streams (8192=0dB, 5800=-3dB, 4106=-6dB)");
+
 struct avs_cmd_shared_mem_map_regions {
 	u16 mem_pool_id;
 	u16 num_regions;
@@ -232,6 +249,28 @@
 	uint32_t dec_fmt_id;
 } __packed;
 
