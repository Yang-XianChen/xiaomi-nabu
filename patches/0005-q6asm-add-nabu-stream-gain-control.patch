 		default:
 			dev_err(ac->dev, "command[0x%x] not expecting rsp\n",
 				result->opcode);
@@ -914,6 +959,43 @@
 }
 
 /**
+ * q6asm_set_stream_gain() - set master gain on an ASM stream
+ *
+ * @ac: audio client pointer
+ * @stream_id: stream id of q6asm session
+ * @gain_q13: linear gain in Q13 format (8192 = 0 dB)
+ *
+ * Return: zero on success or negative error. Failing to set the gain is
+ * non-fatal for playback; callers should only log a warning.
+ */
+static int q6asm_set_stream_gain(struct audio_client *ac, uint32_t stream_id,
+			  u16 gain_q13)
+{
+	struct asm_volume_ctrl_master_gain vol;
+	int rc;
+
+	if (!ac || gain_q13 == 0 || gain_q13 > 8192)
+		return -EINVAL;
+
+	memset(&vol, 0, sizeof(vol));
+	q6asm_add_hdr(ac, &vol.hdr, sizeof(vol), true, stream_id);
+	vol.hdr.opcode = ASM_STREAM_CMD_SET_PP_PARAMS_V2;
+	vol.param.data_payload_size = sizeof(vol) - sizeof(vol.hdr) -
+				      sizeof(vol.param);
+	vol.data.module_id = ASM_MODULE_ID_VOL_CTRL;
+	vol.data.param_id = ASM_PARAM_ID_VOL_CTRL_MASTER_GAIN;
+	vol.data.param_size = vol.param.data_payload_size - sizeof(vol.data);
+	vol.master_gain = gain_q13;
+
+	rc = q6asm_ac_send_cmd_sync(ac, (struct apr_pkt *)&vol);
+	if (rc)
+		dev_warn(ac->dev, "set stream gain 0x%x failed rc=%d\n",
+			 gain_q13, rc);
+
+	return rc;
+}
+
+/**
  * q6asm_open_write() - Open audio client for writing
  * @ac: audio client pointer
  * @stream_id: stream id of q6asm session
@@ -1131,6 +1213,9 @@
 	}
 
 	rc = q6asm_ac_send_cmd_sync(ac, pkt);
+	if (!rc && nabu_stream_gain_q13 > 0 && nabu_stream_gain_q13 <= 8192)
+		q6asm_set_stream_gain(ac, stream_id,
+				      (u16)nabu_stream_gain_q13);
 
 err:
 	kfree(pkt);
