+static int q6asm_dai_close_stream(struct q6asm_dai_rtd *prtd)
+{
+	int ret, i;
+
+	for (i = 0; i < 50; i++) {
+		ret = q6asm_cmd(prtd->audio_client, prtd->stream_id, CMD_CLOSE);
+		if (!ret)
+			return 0;
+		usleep_range(9000, 11000);
+	}
+	return ret;
+}
